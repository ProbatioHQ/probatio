{
  "$schema": "https://json.schemastore.org/tsconfig",

  // Only for scripts run through tsx, never for a build.
  //
  // Everything under app/lib begins with `import 'server-only'`, which is Next's
  // build-time guard against server code reaching a client bundle. It has no
  // runtime behaviour and no entry point outside Next's bundler, so a plain
  // script importing any of it fails to resolve before it runs a line. The unit
  // tests already stand it in with a Vite alias; this is the same stand-in for
  // tsx, so a script can drive the real modules rather than a copy of them.
  "compilerOptions": {
    "target": "ES2022",
    // Checking, not building: no emit, and the same strictness the rest of the
    // workspace is held to. `skipLibCheck` because a script's types are the
    // point and Next's shipped declarations are not.
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    // The harness imports sibling scripts by their real filename, which is how
    // tsx resolves them and what tsc needs telling about.
    "allowImportingTsExtensions": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "server-only": ["./test-support/server-only.ts"],
      "@/*": ["./app/*"]
    }
    },

  // Scoped so `tsc -p` can use this to check the scripts.
  //
  // Without an `include` this config claims the whole repository, so pointing a
  // typechecker at it pulled in every page and failed on JSX it was never meant
  // to compile. Which is why nothing ever pointed one at it, and why the
  // restore-drill seeder sat with a missing required property: `scripts/` was
  // the one directory in the workspace nobody was checking.
  "include": ["scripts/**/*.ts", "scripts/**/*.mts", "test-support/**/*.ts"]
}
