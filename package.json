{
  "name": "probatio",
  "version": "0.0.0",
  "private": true,
  "description": "Probatio \u2014 a proving ground for traders. Honest simulation, unfakeable records.",
  "license": "AGPL-3.0",
  "workspaces": [
    "packages/*",
    "app"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
