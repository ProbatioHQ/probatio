node_modules/
dist/
.next/
out/
build/
coverage/
*.tsbuildinfo

.env
.env.*
!.env.example

target/
test-ledger/
.anchor/

.DS_Store
*.log
npm-debug.log*

# Never commit a keypair. Not in dev, not "just for testing".
*.json.key
keypair*.json
id.json

# Local development database
#
# Every sidecar, not just the database. A rollback journal holds the original
# contents of the pages being overwritten and a WAL holds the new ones, so
# either can carry real rows — wallet addresses and trade history — even when
# the .db itself is ignored. The journal was the one missing, and a file of
# that name was tracked.
*.db
*.db-shm
*.db-wal
*.db-journal
# The recovery path renames a database it cannot read to `.corrupt`, and those
# do not match `*.db`. One was staged by an `add -A` before this line existed.
*.db.corrupt
*.db.corrupt-shm
*.db.corrupt-wal
backups/

# The account snapshot, which is the database in another coat.
#
# `.db` and its sidecars are ignored above for carrying wallet addresses and
# trade history. This file is that same data exported to JSON by the backup
# worker, written next to the database it snapshots, and it was tracked: 26
# commits of real users, accounts, positions and trades.
accounts-snapshot.json

# Brand assets and the script that renders them. Local only.
brand/
scripts/make-header.mjs

# Build output for the two packages published to npm. `scripts/build-npm.mjs`
# compiles into dist/ and assembles the publishable directory in npm/; both are
# regenerated by that script and neither belongs in the repo.
packages/*/dist/
packages/*/npm/

# Local-only credentials. Never committed: this repo is public.
NPMK/
