# Copy to .env.local and fill in.

# ---------------------------------------------------------------------------
# Required. The app refuses to start without these.
# ---------------------------------------------------------------------------

# A local file is fine for development. Turso comes later.
DATABASE_URL=file:./probatio.db
# DATABASE_AUTH_TOKEN=

# At least 32 characters. Generate one with: openssl rand -hex 32
# Every session token is forgeable without this, so the app refuses to start
# rather than run with a weak one.
SESSION_SECRET=

# What the sign-in message says the user is signing in to. Read from config
# rather than from the request, so a forged Host header cannot get someone to
# sign a message naming another site.
APP_DOMAIN=localhost:3000
APP_URI=http://localhost:3000

# ---------------------------------------------------------------------------
# Optional, but wrong defaults have consequences.
# ---------------------------------------------------------------------------

# The public cluster works for trying things out but rate-limits hard.
# A paid endpoint is needed for real use.
RPC_URL=https://api.mainnet-beta.solana.com

# How many proxies sit between the internet and this server.
#
# THIS ONE MATTERS. The rate limiter reads the client address from the right of
# `x-forwarded-for`, counting past exactly this many hops. Too high and a shared
# proxy is limited as one caller; TOO LOW AND A CALLER CHOOSES THEIR OWN KEY,
# which means the limiter enforces nothing while appearing to work.
#
# Set it to match the deployment. One is right for a single proxy in front,
# which is the usual arrangement on a platform host. See docs/rate-limits.md.
TRUSTED_PROXIES=1

# The key that commits records to the chain. A path to a Solana keypair file.
#
# Unset, the app records trades locally and reports them honestly as not
# committed — which is the correct state to be in rather than one to hide.
# Set it and the keeper starts a commit loop.
#
# This key can only append records. It cannot change a season, take an entry,
# or move a lamport. See docs/keeper-key.md for the blast radius and rotation.
# KEEPER_KEYPAIR=/path/to/keeper.json

# Where season entry fees are paid. Payment routes return 503 while it is
# unset, which is deliberate — there is no sensible default for where money
# goes.
# TREASURY_ADDRESS=

# The coach. Unset means /api/coach returns 503 and nothing else changes;
# every other feature works without it.
# ANTHROPIC_API_KEY=
# COACH_MODEL=claude-sonnet-5

# ---------------------------------------------------------------------------
# Operational switches.
# ---------------------------------------------------------------------------

# Set to 1 to stop the launch feed websocket. Used for builds and tests, where
# a live socket is noise. Health still reports the feed as down, because a feed
# that is not running is not a feed that is working.
# PROBATIO_DISABLE_FEED=1
