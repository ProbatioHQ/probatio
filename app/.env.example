# Copy to .env.local and fill in.

# ---------------------------------------------------------------------------
# Required. The app refuses to start without these.
# ---------------------------------------------------------------------------

# A local file is fine for development. Turso comes later.
DATABASE_URL=file:./probatio.db
# DATABASE_AUTH_TOKEN=

# At least 32 characters. Generate one with: openssl rand -hex 32
# Every session token is forgeable without this, so the app refuses to start
# rather than run with a weak one.
SESSION_SECRET=

# What the sign-in message says the user is signing in to. Read from config
# rather than from the request, so a forged Host header cannot get someone to
# sign a message naming another site.
APP_DOMAIN=localhost:3000
APP_URI=http://localhost:3000

# ---------------------------------------------------------------------------
# Optional, but wrong defaults have consequences.
# ---------------------------------------------------------------------------

# The public cluster works for trying things out but rate-limits hard.
# A paid endpoint is needed for real use.
RPC_URL=https://api.mainnet-beta.solana.com

# How many proxies sit between the internet and this server.
#
# THIS ONE MATTERS. The rate limiter reads the client address from the right of
# `x-forwarded-for`, counting past exactly this many hops. Too high and a shared
# proxy is limited as one caller; TOO LOW AND A CALLER CHOOSES THEIR OWN KEY,
# which means the limiter enforces nothing while appearing to work.
#
# Set it to match the deployment. One is right for a single proxy in front,
# which is the usual arrangement on a platform host.
#
# Zero means nothing sits in front of this server, and is handled as its own
# case: with no proxy, every forwarding header is written by the caller, so
# none of them are believed and everyone shares one bucket. Correct, and
# blunt — do not set zero if there is in fact a proxy.
#
# See docs/rate-limits.md.
TRUSTED_PROXIES=1

# The key that commits records to the chain. In any of three forms: the keypair
# array inline (starts with `[`, from solana-keygen), a base58 private key as
# Phantom exports it, or a path to a keypair file. The inline forms suit a host
# with no persistent file, such as Railway.
#
# Unset, the app records trades locally and reports them honestly as not
# committed — which is the correct state to be in rather than one to hide.
# Set it and the keeper starts a commit loop.
#
# This key can only append records. It cannot change a season, take an entry,
# or move a lamport. See docs/keeper-key.md for the blast radius and rotation.
# KEEPER_KEYPAIR=/path/to/keeper.json

# The key that runs a season: it creates it on chain, opens and closes its
# entries, and finalizes it against the results. Same three forms as
# KEEPER_KEYPAIR (inline array, base58 from Phantom, or a file path).
#
# Unset, ranked seasons are never created on chain, so the paid path stays
# closed. This key can grief a season (void it, finalize it early) but cannot
# move prize money to itself: claims and refunds are signed by the trader being
# paid, and the vault only ever pays the address a signed entry names.
# AUTHORITY_KEYPAIR=/path/to/authority.json

# Where store payments go. Your revenue; a plain address you control, nothing
# is ever sent from it by the server. Store routes return 503 while unset.
# TREASURY_ADDRESS=

# The prize wallet: entry fees are paid into it, and when a season ends the app
# pays the winners out of it automatically. A hot key, so the server can sign
# the payouts unattended — keep only the prize pot in it, not your revenue. Same
# three forms as KEEPER_KEYPAIR (inline array, base58 from Phantom, or a path).
# Unset, paid seasons stay closed because there is nothing to pay winners from.
#
# This is the simple custody model: you hold the pot and pay it out. The
# on-chain alternative (KEEPER/AUTHORITY below, a deployed program, a trustless
# vault) is optional and not needed for this.
# PRIZE_KEYPAIR=

# The coach. Unset means /api/coach returns 503 and nothing else changes;
# every other feature works without it.
# ANTHROPIC_API_KEY=
# COACH_MODEL=claude-sonnet-5

# ---------------------------------------------------------------------------
# Operational switches.
# ---------------------------------------------------------------------------

# Set to 1 to stop the launch feed websocket. Used for builds and tests, where
# a live socket is noise. Health still reports the feed as down, because a feed
# that is not running is not a feed that is working.
# PROBATIO_DISABLE_FEED=1

# Set to 1 to stop the live price stream worker (accountSubscribe). The chart
# still polls candles; only the pushed real-time price goes away.
# PROBATIO_DISABLE_PRICE_STREAM=1

# Set to 1 to stop the drift monitor. It replays real swaps through the engine
# and suspends any token filling better here than on chain; disable it only when
# there is no usable RPC to measure against.
# PROBATIO_DISABLE_DRIFT=1

# How deep a chart backfill walks, in transactions, for the curve and the pool.
# Auto-tuned from the endpoint (gentle on the public RPC, deep on a dedicated
# one); set these to override that when you know what your node will tolerate.
# PROBATIO_BACKFILL_TRANSACTIONS=2000
# PROBATIO_POOL_BACKFILL_TRANSACTIONS=2000
